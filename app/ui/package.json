{
  "name": "relay-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4180",
    "typecheck": "tsc --noEmit",
    "check:render": "vite build --ssr src/prerender.tsx --outDir ./.prerender --emptyOutDir && node scripts/check-render.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@forge/bridge": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
